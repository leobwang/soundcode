\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Per-arm Phase~1 summary. \textbf  {Sched.}\ is the verifier-loop scheduling (\textsf  {plain}: no verifier; \textsf  {sync}: ROCODE-style block-and-wait; \textsf  {async}: SoundCode producer-consumer); \textbf  {Rollback} is the policy when a blocking diagnostic fires. \textbf  {pass@1} is compile $\wedge $ tests-pass on the official MultiPL-E test cases; \textbf  {comp.}\ is compile rate; \textbf  {wall} is per-problem wall-clock; \textbf  {rb} is rollback count; \textbf  {toks} is generated tokens. Bold marks the fastest verified (sync/async) arm's wall-clock per language; no verified arm significantly improves pass@1 or compile rate over \textsf  {Vanilla} (see \emph  {Statistical note}). The \textsc  {ROCODE-upstream-cpp} arm was skipped~--- see footnote.}}{12}{table.2}\protected@file@percent }
\newlabel{tab:main}{{2}{12}{Per-arm Phase~1 summary. \textbf {Sched.}\ is the verifier-loop scheduling (\textsf {plain}: no verifier; \textsf {sync}: ROCODE-style block-and-wait; \textsf {async}: SoundCode producer-consumer); \textbf {Rollback} is the policy when a blocking diagnostic fires. \textbf {pass@1} is compile $\wedge $ tests-pass on the official MultiPL-E test cases; \textbf {comp.}\ is compile rate; \textbf {wall} is per-problem wall-clock; \textbf {rb} is rollback count; \textbf {toks} is generated tokens. Bold marks the fastest verified (sync/async) arm's wall-clock per language; no verified arm significantly improves pass@1 or compile rate over \textsf {Vanilla} (see \emph {Statistical note}). The \textsc {ROCODE-upstream-cpp} arm was skipped~--- see footnote}{table.2}{}}
