\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces ROCODE \citep  {jiang2024rocode}: the compiler runs synchronously after each emitted statement; on a detected error, the buffer is rolled back to the compiler-reported line, or, on recurrence, to the line containing the highest-entropy token. The retry decodes under an exponentially-decaying token-penalty mask.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:rocode-workflow}{{2}{5}{ROCODE \citep {jiang2024rocode}: the compiler runs synchronously after each emitted statement; on a detected error, the buffer is rolled back to the compiler-reported line, or, on recurrence, to the line containing the highest-entropy token. The retry decodes under an exponentially-decaying token-penalty mask}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces SemGuard \citep  {wang2025semguard}: a learned 1.3B semantic classifier scores each emitted line; if the score drops below 0.5, the buffer is rolled back to the start of the offending line and the LM resamples under a single-token penalty on the first non-indent token, up to $N$ retries.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:semguard-workflow}{{3}{5}{SemGuard \citep {wang2025semguard}: a learned 1.3B semantic classifier scores each emitted line; if the score drops below 0.5, the buffer is rolled back to the start of the offending line and the LM resamples under a single-token penalty on the first non-indent token, up to $N$ retries}{figure.3}{}}
