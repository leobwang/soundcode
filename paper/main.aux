\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Verifier cost spectrum. Times are typical per-call on a single CPU core (verifier) or on an H100 (LM-as-verifier, batch=1, $K\!=\!1$ token). Per-token LM cost is $\sim $$10$--$30\,\mathrm  {ms}$ for a 7B-class model. The async / sync prediction is whether per-call verifier cost exceeds per-token LM cost.}}{9}{table.1}\protected@file@percent }
\newlabel{tab:verifier-cost}{{1}{9}{Verifier cost spectrum. Times are typical per-call on a single CPU core (verifier) or on an H100 (LM-as-verifier, batch=1, $K\!=\!1$ token). Per-token LM cost is $\sim $$10$--$30\,\mathrm {ms}$ for a 7B-class model. The async / sync prediction is whether per-call verifier cost exceeds per-token LM cost}{table.1}{}}
